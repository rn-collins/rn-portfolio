# Copy to .env and fill in. Never commit real secrets.

# --- Database ---
DATABASE_URL=postgres://lurker:lurker@localhost:5432/creator_lurker
POSTGRES_USER=lurker
POSTGRES_PASSWORD=lurker
POSTGRES_DB=creator_lurker

# --- Collection ---
APIFY_TOKEN=
BRIGHTDATA_API_KEY=
PHYLLO_CLIENT_ID=
PHYLLO_CLIENT_SECRET=
BRANDWATCH_API_TOKEN=

# --- Local LLM (Ollama) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
EMBED_MODEL=nomic-embed-text

# --- n8n ---
N8N_PORT=5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me

# --- Alerts ---
ALERT_EMAIL=collins.ra@husky.neu.edu
SLACK_WEBHOOK_URL=

# --- Guardrails ---
COLLECT_PUBLIC_ONLY=true          # do not scrape private/authed content
RESPECT_ROBOTS=true
